# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# --- Database -------------------------------------------------------------
# Default (unset) uses a local SQLite file: sqlite:///urja.db
# Production example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/urja
DATABASE_URL=

# --- Event bus ------------------------------------------------------------
# Unset => in-memory bus (fine for dev/demo). Set to swap in Redis Streams.
REDIS_URL=

# --- API ------------------------------------------------------------------
# Comma-separated origins for the React portals (Dev C/D). "*" in dev.
CORS_ORIGINS=*

# Re-seed config tables on startup (1=yes, 0=no). Idempotent, safe to leave on.
SEED_ON_STARTUP=1

# --- Auth (JWT) -----------------------------------------------------------
# Generate a real one for production, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# --- Watch agent (Groq LLM + RAG) -----------------------------------------
# 1 => Watch uses the real RAG+LLM agent once GROQ_API_KEY (below) is also
# set; with no key, this still safely falls back to the deterministic
# keyword-bump stub (Settings.use_real_agents alone is not enough --
# run_watch() requires both). A fresh clone with no .env at all is
# unaffected by this file and defaults to 0/stub regardless (backend/
# config.py's own Settings default) -- this only matters once you've
# copied this file to .env.
USE_REAL_AGENTS=1
GROQ_API_KEY=
WATCH_MODEL_PRIMARY=llama-3.3-70b-versatile
WATCH_MODEL_FALLBACK=llama-3.1-8b-instant
VECTOR_STORE_PATH=
LLM_CACHE_DIR=

# --- Geospatial data (AIS replay + dark-ship detector) ---------------------
# Unset => the curated, committed replay set (backend/agents/data/
# ais_sample.json). Point this at a different source producing the same
# {id, corridor_id, track[]} shape (e.g. a live-feed adapter's export) to
# swap the geo/anomaly pipeline onto real data with no code change.
AIS_DATA_PATH=

# --- Docker Compose only ----------------------------------------------------
# Password for the postgres container (docker-compose.yml). Not read by the
# app directly -- only used to build DATABASE_URL and to init the postgres
# container. Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Frontend build args (docker-compose.yml passes these to India Connect
# Portal/Dockerfile at image-build time -- see that file's comments).
# VITE_API_URL/VITE_WS_URL default to localhost:8000, only correct when
# opening the frontend from the same machine Docker runs on -- override both
# for any real deployment.
VITE_API_URL=
VITE_WS_URL=
# Google Maps JS API browser key (see India Connect Portal/.env.example for
# where it's used and how to restrict it). Left blank, the map silently
# falls back to the static IndiaMap SVG instead of failing the build.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
