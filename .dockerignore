*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

*.db
*.sqlite3
backend/agents/.chroma/

.env
.env.*
!.env.example

.git/
.vscode/
.idea/

