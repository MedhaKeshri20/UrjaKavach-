# Frontend config. Copy this file to .env locally and fill in real values —
# .env is gitignored and must never be committed (see AGENTS.md's "Secrets"
# section and spec.md Phase 0).

# Google Maps JavaScript API browser key, used by src/components/kavach/RealWorldMap.tsx.
# Get one from https://console.cloud.google.com/google/maps-apis — restrict it
# by HTTP referrer (your dev + deploy origins only) before use.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# Optional: Google Maps usage-tracking channel id. Safe to leave blank.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Where vite.config.ts's dev proxy forwards /api/* (server-side only — never
# sent to the browser). Leave unset for a local backend on the default port.
# BACKEND_URL=http://localhost:8000

# Backend API base (REST) as seen by the browser. Leave unset in local dev —
# it defaults to "/api", proxied to BACKEND_URL by vite.config.ts (see
# spec.md Phase 3); set explicitly (e.g. https://api.example.com) for a
# deployed backend that isn't behind this app's own proxy.
# VITE_API_URL=

# Backend WebSocket URL for live RiskState updates (/ws/state).
# Defaults to ws://<host>:8000/ws/state when unset.
# VITE_WS_URL=
